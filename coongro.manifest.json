{
  "id": "consultations",
  "version": "0.10.0",
  "apiVersion": "2.0",
  "entry": "dist/entry.js",
  "assets": { "styles": ["./dist/assets/tailwind.css"] },
  "contributes": {
    "menus": [
      {
        "path": "Consultas",
        "order": 2,
        "icon": "assets/icons/stethoscope.svg",
        "color": "#8B5CF6",
        "viewId": "consultations.list.open"
      },
      {
        "path": "Servicios y Precios",
        "order": 2,
        "icon": "assets/icons/tags.svg",
        "color": "#0EA5E9",
        "viewId": "consultations.services.open"
      }
    ],
    "views": [
      {
        "id": "consultations.list.open",
        "title": "Historial de Consultas",
        "component": "./dist/views/consultations-list/index.js",
        "export": "ConsultationsListView"
      },
      {
        "id": "consultations.detail.open",
        "title": "Detalle Consulta",
        "component": "./dist/views/consultation-detail/index.js",
        "export": "ConsultationDetailView"
      },
      {
        "id": "consultations.form.open",
        "title": "Formulario Consulta",
        "component": "./dist/views/consultation-form/index.js",
        "export": "ConsultationFormView"
      },
      {
        "id": "consultations.services.open",
        "title": "Servicios y Precios",
        "component": "./dist/views/services/index.js",
        "export": "ServicesView"
      }
    ],
    "repositories": [
      {
        "module": "./dist/repositories/consultation.repository.js",
        "export": "ConsultationRepository",
        "prefix": "consultations.records"
      },
      {
        "module": "./dist/repositories/consultation-medication.repository.js",
        "export": "ConsultationMedicationRepository",
        "prefix": "consultations.medications"
      },
      {
        "module": "./dist/repositories/consultation-service.repository.js",
        "export": "ConsultationServiceRepository",
        "prefix": "consultations.services"
      }
    ],
    "viewOverrides": [
      {
        "targetViewId": "patients.detail.open",
        "component": "./dist/views/detail-override/index.js",
        "export": "DetailOverrideView",
        "priority": 10,
        "title": "Ficha Paciente"
      }
    ],
    "settings": {
      "sections": [
        {
          "id": "consultations.general.main",
          "page": "consultations.general",
          "label": "General",
          "order": 10,
          "items": [
            {
              "key": "consultations.showPrices",
              "type": "boolean",
              "label": "Servicios y precios en consultas",
              "description": "Mostrar la sección de servicios prestados y precios en el formulario de consulta",
              "default": true,
              "tags": ["consultations", "showprices", "servicios", "precios"]
            }
          ]
        },
        {
          "id": "consultations.general.vet",
          "page": "consultations.general",
          "label": "Veterinario",
          "order": 15,
          "component": "./dist/index.js",
          "export": "DefaultVetSetting"
        },
        {
          "id": "consultations.formulario",
          "page": "consultations.general",
          "label": "Formulario",
          "order": 20,
          "items": [
            {
              "key": "consultations.prefillVitals",
              "type": "boolean",
              "label": "Prellenar signos vitales",
              "description": "Al crear una consulta, prellenar peso, temperatura, FC, FR y BCS con los valores de la última consulta del paciente",
              "default": true,
              "tags": [
                "consultations",
                "prefillvitals",
                "prellenar",
                "signos",
                "vitales"
              ]
            },
            {
              "key": "consultations.structuredExam",
              "type": "boolean",
              "label": "Examen físico estructurado",
              "description": "Mostrar checklist por sistemas (WNL/ABN) en vez de texto libre para el examen físico",
              "default": true,
              "tags": [
                "consultations",
                "structuredexam",
                "examen",
                "físico",
                "sistemas"
              ]
            }
          ]
        },
        {
          "id": "consultations.general.required",
          "page": "consultations.general",
          "label": "Campos obligatorios",
          "order": 25,
          "items": [
            {
              "key": "consultations.required.reason",
              "type": "boolean",
              "label": "Motivo obligatorio",
              "description": "Requerir el motivo de consulta para poder guardar.",
              "default": true,
              "tags": ["consultations", "required", "motivo", "obligatorio"]
            },
            {
              "key": "consultations.required.diagnosis",
              "type": "boolean",
              "label": "Diagnóstico obligatorio",
              "description": "Requerir el diagnóstico para poder guardar la consulta.",
              "default": false,
              "tags": [
                "consultations",
                "required",
                "diagnostico",
                "obligatorio"
              ]
            }
          ]
        }
      ],
      "groups": [{ "id": "consultations", "label": "Consultas", "order": 50 }],
      "pages": [
        {
          "id": "consultations.general",
          "group": "consultations",
          "label": "Consulta",
          "icon": "assets/icons/stethoscope.svg",
          "order": 10
        }
      ]
    }
  }
}
